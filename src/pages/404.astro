---
import BaseLayout from "../layouts/BaseLayout.astro";
import { defaultLocale, locales } from "../config/locales";
import { t } from "../i18n/ui";
import { paths } from "../lib/urls";

// GitHub Pages serves a single 404.html for every locale, so show all languages.
const strings = t(defaultLocale);
---

<BaseLayout locale={defaultLocale} title={strings.notFound.title} noindex>
  <div class="mx-auto max-w-xl py-12 text-center">
    <p class="mb-2 text-6xl font-bold text-brand-600" aria-hidden="true">
      404
    </p>
    {locales.map((l) => (
      <section lang={l} class="mb-8">
        <h1 class="mb-2 text-2xl font-bold">{t(l).notFound.title}</h1>
        <p class="mb-3 text-stone-700">{t(l).notFound.body}</p>
        <a href={paths.recipes(l)} class="font-semibold">
          {t(l).notFound.back} →
        </a>
      </section>
    ))}
  </div>
</BaseLayout>
