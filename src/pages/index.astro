---
import { defaultLocale, locales, localeMeta } from "../config/locales";
import { t } from "../i18n/ui";
import { paths, withBase } from "../lib/urls";

// GitHub Pages cannot redirect server-side, so the root page forwards to the
// default locale via meta refresh and offers plain links as a fallback.
const target = paths.home(defaultLocale);
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t(defaultLocale).siteName}</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={new URL(target, Astro.site).href} />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
  </head>
  <body style="font-family: system-ui, sans-serif; padding: 2rem">
    <ul>
      {locales.map((l) => (
        <li>
          <a href={paths.home(l)} lang={l}>
            {t(l).siteName} ({localeMeta[l].label})
          </a>
        </li>
      ))}
    </ul>
  </body>
</html>
